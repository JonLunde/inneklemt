---
import type { MonthGroup } from '../utils/groupByMonth';
import DayCard from './DayCard.astro';
import ValueBadge from './ValueBadge.astro';

interface Props {
  monthGroup: MonthGroup;
  isOpen?: boolean;
}

const { monthGroup: { monthName, monthKey, groups }, isOpen = false } = Astro.props;

const tooltipText = 'Fridager du får per feriedag du tar ut. Høyere er bedre.';

const groupStats = groups.map((group) => {
  const inneklemtDays = group.filter((d) => d.description === 'inneklemt');
  const inneklemtCount = inneklemtDays.length;
  const ratioNum = group.length / inneklemtCount;
  const dayWord = inneklemtCount === 1 ? 'inneklemt dag' : 'inneklemte dager';
  const badgeLabel = `${ratioNum.toFixed(1)} fridager per feriedag. ${tooltipText}`;
  return { group, inneklemtCount, ratioNum, dayWord, badgeLabel };
});

// Unique per page: one tooltip per period, keyed by month and position.
const tooltipId = (i: number) => `tip-${monthKey}-${i}`;

const totalInneklemt = groupStats.reduce((sum, gs) => sum + gs.inneklemtCount, 0);
const totalDayWord = totalInneklemt === 1 ? 'inneklemt dag' : 'inneklemte dager';
---

<details open={isOpen} class="group bg-surface border border-border rounded-xl overflow-hidden shadow-sm">
  <summary class="flex items-center justify-between px-5 py-4 cursor-pointer hover:bg-bg transition-colors">
    <span class="font-semibold text-text">
      {monthName}
      <span class="text-text-muted font-normal text-sm ml-2">· {totalInneklemt} {totalDayWord}</span>
    </span>
    <div class="flex items-center gap-3 flex-shrink-0">
      <svg
        class="w-5 h-5 text-text-muted transition-transform duration-200 group-open:rotate-180"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </summary>

  <div class="border-t border-border p-4 space-y-3">
    {groupStats.map((gs, i) => (
      <div class="rounded-lg border border-border">
        <div class="flex items-center justify-between px-4 py-2.5 bg-bg border-b border-border">
          <span class="text-sm font-medium text-text-muted">{gs.inneklemtCount} {gs.dayWord}</span>
          {/* Native popover: opens on tap/click/Enter and closes on tap outside or Esc (light dismiss),
              with zero client JS. Hover still shows it on devices with a real pointer (see global.css). */}
          <div class="tooltip-anchor">
            <button
              type="button"
              class="tooltip-trigger cursor-help select-none rounded"
              popovertarget={tooltipId(i)}
              aria-label={gs.badgeLabel}
              style={`anchor-name: --${tooltipId(i)}`}
            >
              <ValueBadge ratio={gs.ratioNum} aria-hidden="true" />
            </button>
            <div id={tooltipId(i)} popover class="tooltip-content" style={`position-anchor: --${tooltipId(i)}`}>
              {tooltipText}
            </div>
          </div>
        </div>
        <div class="divide-y divide-border overflow-hidden rounded-b-lg">
          {gs.group.map((day) => <DayCard day={day} />)}
        </div>
      </div>
    ))}
  </div>
</details>
