---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Pick<HTMLAttributes<'span'>, 'class' | 'tabindex' | 'role' | 'aria-label' | 'aria-hidden' | 'title'> {
  ratio: number;
}

const { ratio, class: className, ...attrs } = Astro.props;

const style =
  ratio >= 3
    ? 'background:#15803D;color:#fff'
    : ratio >= 2
      ? 'background:#16A34A;color:#fff'
      : 'background:#22C55E;color:#fff';
---

<span style={style} class:list={['text-sm font-bold px-2.5 py-1 rounded', className]} {...attrs}>
  {ratio.toFixed(1)}×
</span>
